<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <record id="seq_re_contract" model="ir.sequence">
        <field name="name">Real Estate Contract</field>
        <field name="code">re.contract</field>
        <field name="prefix">CNT-%(year)s-</field>
        <field name="padding">3</field>
        <field name="company_id" eval="False"/>
    </record>
    <record id="seq_re_customer" model="ir.sequence">
        <field name="name">Real Estate Customer</field>
        <field name="code">re.customer</field>
        <field name="prefix">CUS-</field>
        <field name="padding">4</field>
        <field name="company_id" eval="False"/>
    </record>
</odoo>
