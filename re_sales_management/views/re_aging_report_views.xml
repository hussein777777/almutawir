<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="re_aging_view_pivot" model="ir.ui.view">
        <field name="name">re.receivable.aging.pivot</field>
        <field name="model">re.receivable.aging</field>
        <field name="arch" type="xml">
            <pivot string="Receivables Aging" disable_linking="0">
                <field name="partner_id" type="row"/>
                <field name="remaining_amount" type="measure"/>
                <field name="not_due" type="measure"/>
                <field name="bucket_0_30" type="measure"/>
                <field name="bucket_31_60" type="measure"/>
                <field name="bucket_61_90" type="measure"/>
                <field name="bucket_90_plus" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="re_aging_view_list" model="ir.ui.view">
        <field name="name">re.receivable.aging.list</field>
        <field name="model">re.receivable.aging</field>
        <field name="arch" type="xml">
            <list create="0" edit="0" delete="0">
                <field name="partner_id"/>
                <field name="contract_id"/>
                <field name="project_id"/>
                <field name="unit_id" optional="show"/>
                <field name="installment_id"/>
                <field name="due_date"/>
                <field name="days_overdue"/>
                <field name="currency_id" column_invisible="1"/>
                <field name="remaining_amount" widget="monetary" sum="Total"/>
                <field name="not_due" widget="monetary" sum="Total" optional="show"/>
                <field name="bucket_0_30" widget="monetary" sum="Total"/>
                <field name="bucket_31_60" widget="monetary" sum="Total"/>
                <field name="bucket_61_90" widget="monetary" sum="Total"/>
                <field name="bucket_90_plus" widget="monetary" sum="Total"/>
            </list>
        </field>
    </record>

    <record id="re_aging_view_graph" model="ir.ui.view">
        <field name="name">re.receivable.aging.graph</field>
        <field name="model">re.receivable.aging</field>
        <field name="arch" type="xml">
            <graph string="Receivables Aging" type="bar">
                <field name="bucket"/>
                <field name="remaining_amount" type="measure"/>
            </graph>
        </field>
    </record>

    <record id="re_aging_view_search" model="ir.ui.view">
        <field name="name">re.receivable.aging.search</field>
        <field name="model">re.receivable.aging</field>
        <field name="arch" type="xml">
            <search>
                <field name="partner_id"/>
                <field name="contract_id"/>
                <field name="project_id"/>
                <filter name="overdue_only" string="Overdue" domain="[('days_overdue', '&gt;', 0)]"/>
                <filter name="not_due" string="Not Due Yet" domain="[('days_overdue', '=', 0)]"/>
                <group expand="0" string="Group By">
                    <filter name="group_partner" string="Customer" context="{'group_by': 'partner_id'}"/>
                    <filter name="group_project" string="Project" context="{'group_by': 'project_id'}"/>
                    <filter name="group_contract" string="Contract" context="{'group_by': 'contract_id'}"/>
                    <filter name="group_bucket" string="Aging Bucket" context="{'group_by': 'bucket'}"/>
                    <filter name="group_user" string="Salesperson" context="{'group_by': 'user_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="re_aging_action" model="ir.actions.act_window">
        <field name="name">Receivables Aging</field>
        <field name="res_model">re.receivable.aging</field>
        <field name="view_mode">pivot,list,graph</field>
        <field name="context">{'search_default_overdue_only': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Nothing overdue</p>
            <p>Unpaid installments of active contracts appear here, grouped by how late they are.</p>
        </field>
    </record>
</odoo>
