<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Installment dialog ("Add Installment") -->
    <record id="re_installment_view_form" model="ir.ui.view">
        <field name="name">re.contract.installment.form</field>
        <field name="model">re.contract.installment</field>
        <field name="arch" type="xml">
            <form string="Installment">
                <header>
                    <button name="action_create_invoice" type="object" string="Create Invoice"
                            invisible="invoice_id or contract_state not in ('active', 'closed') or not id"/>
                    <button name="action_register_payment" type="object" string="Record Payment" class="btn-primary"
                            invisible="state in ('paid', 'cancelled') or contract_state not in ('active', 'closed') or not id"/>
                    <field name="state" widget="statusbar" statusbar_visible="upcoming,overdue,paid"/>
                </header>
                <sheet>
                    <div class="row">
                        <div class="col-lg-7">
                            <group>
                                <field name="contract_id" invisible="context.get('default_contract_id')" readonly="id"/>
                                <field name="name"/>
                                <field name="installment_type"/>
                                <field name="amount_type" widget="radio" options="{'horizontal': true}"/>
                                <field name="percent" invisible="amount_type != 'percent'"/>
                                <field name="currency_id" invisible="1"/>
                                <field name="amount" widget="monetary" readonly="amount_type == 'percent'" force_save="1"/>
                                <field name="due_date"/>
                                <field name="payment_method"/>
                                <field name="reference"/>
                                <field name="notes" placeholder="Add any notes..."/>
                            </group>
                        </div>
                        <div class="col-lg-5">
                            <div class="o_re_info_panel">
                                <div class="o_re_info_title"><i title="Info Circle" class="fa fa-info-circle me-2"/>Installment Information</div>
                                <div class="o_re_info_row"><span>Unit</span><field name="unit_id" readonly="1"/></div>
                                <div class="o_re_info_row"><span>Unit Price</span><field name="unit_price" widget="monetary"/></div>
                                <div class="o_re_info_row"><span>Total Contract Value</span><field name="contract_value" widget="monetary"/></div>
                                <div class="o_re_info_row"><span>Total Installments</span><field name="contract_installment_count"/></div>
                                <div class="o_re_info_row"><span>This Installment</span><field name="amount" widget="monetary" readonly="1"/></div>
                                <div class="o_re_info_row"><span>Paid</span><field name="paid_amount" widget="monetary"/></div>
                                <div class="o_re_info_row"><span>Contract Remaining</span><field name="contract_remaining" widget="monetary"/></div>
                                <div class="o_re_info_row" invisible="not invoice_id">
                                    <span>Invoice</span><field name="invoice_id" readonly="1"/>
                                </div>
                            </div>
                            <div class="o_re_info_panel o_re_info_blue mt-3" invisible="payment_method != 'bank_transfer'">
                                <div class="o_re_info_title"><i title="University" class="fa fa-university me-2"/>Bank Transfer Notes</div>
                                <ul class="mb-0 small">
                                    <li>Record the transfer reference number for easy tracking.</li>
                                    <li>The installment is marked as paid once the payment is recorded.</li>
                                </ul>
                            </div>
                        </div>
                    </div>
                    <div class="o_re_cheque_box" invisible="payment_method != 'cheque'">
                        <div class="o_re_info_title"><i title="Credit Card" class="fa fa-credit-card me-2"/>Cheque Details</div>
                        <group>
                            <group>
                                <field name="cheque_number" placeholder="e.g. 123456"/>
                                <field name="cheque_bank_id"/>
                            </group>
                            <group>
                                <field name="cheque_date"/>
                                <field name="cheque_amount" widget="monetary"/>
                                <field name="cheque_holder" placeholder="e.g. Ahmed Mohamed"/>
                            </group>
                        </group>
                    </div>
                    <group string="Attachments">
                        <field name="attachment_ids" widget="many2many_binary" nolabel="1" colspan="2"/>
                    </group>
                    <field name="contract_state" invisible="1"/>
                    <field name="company_id" invisible="1"/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="re_installment_view_list" model="ir.ui.view">
        <field name="name">re.contract.installment.list</field>
        <field name="model">re.contract.installment</field>
        <field name="arch" type="xml">
            <list decoration-danger="state == 'overdue'" decoration-muted="state in ('paid', 'cancelled')">
                <field name="due_date"/>
                <field name="contract_id"/>
                <field name="partner_id"/>
                <field name="project_id" optional="show"/>
                <field name="unit_id" optional="show"/>
                <field name="name"/>
                <field name="currency_id" column_invisible="1"/>
                <field name="amount" widget="monetary" sum="Total"/>
                <field name="paid_amount" widget="monetary" sum="Total" optional="show"/>
                <field name="remaining_amount" widget="monetary" sum="Total"/>
                <field name="payment_method" optional="hide"/>
                <field name="cheque_number" optional="hide"/>
                <field name="invoice_id" optional="hide"/>
                <field name="state" widget="badge" decoration-success="state == 'paid'" decoration-info="state == 'upcoming'"
                       decoration-warning="state in ('due', 'partial')" decoration-danger="state == 'overdue'"/>
                <button name="action_register_payment" type="object" string="Pay" icon="fa-money" class="btn-link"
                        invisible="state in ('paid', 'cancelled') or contract_state not in ('active', 'closed')"/>
                <field name="contract_state" column_invisible="1"/>
            </list>
        </field>
    </record>

    <record id="re_installment_view_search" model="ir.ui.view">
        <field name="name">re.contract.installment.search</field>
        <field name="model">re.contract.installment</field>
        <field name="arch" type="xml">
            <search>
                <field name="contract_id"/>
                <field name="partner_id"/>
                <field name="project_id"/>
                <field name="cheque_number"/>
                <filter name="open" string="Unpaid" domain="[('state', 'not in', ('paid', 'cancelled'))]"/>
                <filter name="overdue" string="Overdue" domain="[('state', '=', 'overdue')]"/>
                <filter name="due_today" string="Due Today" domain="[('state', '=', 'due')]"/>
                <filter name="this_month" string="Due This Month"
                        domain="[('due_date', '&gt;=', context_today().strftime('%Y-%m-01')),
                                 ('due_date', '&lt;', (context_today() + relativedelta(months=1)).strftime('%Y-%m-01'))]"/>
                <filter name="paid" string="Paid" domain="[('state', '=', 'paid')]"/>
                <separator/>
                <filter name="active_contracts" string="Active Contracts" domain="[('contract_state', 'in', ('active', 'closed'))]"/>
                <separator/>
                <filter name="cheques" string="Cheques" domain="[('payment_method', '=', 'cheque')]"/>
                <group expand="0" string="Group By">
                    <filter name="group_due_month" string="Due Month" context="{'group_by': 'due_date:month'}"/>
                    <filter name="group_state" string="Status" context="{'group_by': 'state'}"/>
                    <filter name="group_project" string="Project" context="{'group_by': 'project_id'}"/>
                    <filter name="group_partner" string="Customer" context="{'group_by': 'partner_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="re_installment_action" model="ir.actions.act_window">
        <field name="name">Installments</field>
        <field name="res_model">re.contract.installment</field>
        <field name="view_mode">list,form,pivot,graph</field>
        <field name="context">{'search_default_open': 1, 'search_default_active_contracts': 1}</field>
    </record>
</odoo>
