<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_partner_form_re_sales" model="ir.ui.view">
        <field name="name">res.partner.form.re.sales</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button class="oe_stat_button" type="object" name="action_re_view_contracts" icon="fa-file-text-o"
                        invisible="not is_re_customer" groups="re_sales_management.group_re_sales_user">
                    <field name="re_contract_count" widget="statinfo" string="Contracts"/>
                </button>
                <button class="oe_stat_button" type="object" name="action_re_view_installments" icon="fa-calendar"
                        invisible="not is_re_customer" groups="re_sales_management.group_re_sales_user">
                    <field name="re_overdue_count" widget="statinfo" string="Overdue Inst."/>
                </button>
                <button class="oe_stat_button" type="object" name="action_re_view_payments" icon="fa-money"
                        invisible="not is_re_customer" groups="re_sales_management.group_re_sales_user">
                    <div class="o_stat_info"><span class="o_stat_text">Payments</span></div>
                </button>
            </xpath>
            <xpath expr="//notebook" position="inside">
                <page string="Real Estate" name="real_estate" groups="re_sales_management.group_re_sales_user">
                    <div class="o_re_stat_cards" invisible="not is_re_customer">
                        <button type="object" name="action_re_view_contracts" class="o_re_stat_card o_re_card_blue">
                            <i title="File Text" class="fa fa-file-text"/><div><field name="re_contract_count"/><span>Total Contracts</span></div>
                        </button>
                        <div class="o_re_stat_card o_re_card_purple">
                            <i title="Home" class="fa fa-home"/><div><field name="re_total_value" widget="monetary" options="{'currency_field': 're_currency_id'}"/><span>Total Contract Value</span></div>
                        </div>
                        <button type="object" name="action_re_view_payments" class="o_re_stat_card o_re_card_green">
                            <i title="Database" class="fa fa-database"/><div><field name="re_collected" widget="monetary" options="{'currency_field': 're_currency_id'}"/><span>Total Collected (<field name="re_collection_pct" widget="float" digits="[16, 0]" class="d-inline"/>%)</span></div>
                        </button>
                        <div class="o_re_stat_card o_re_card_orange">
                            <i title="Hourglass Half" class="fa fa-hourglass-half"/><div><field name="re_remaining" widget="monetary" options="{'currency_field': 're_currency_id'}"/><span>Remaining Amount</span></div>
                        </div>
                        <button type="object" name="action_re_view_installments" class="o_re_stat_card o_re_card_red">
                            <i title="Exclamation Circle" class="fa fa-exclamation-circle"/><div><field name="re_overdue_amount" widget="monetary" options="{'currency_field': 're_currency_id'}"/><span>Overdue (<field name="re_overdue_count" class="d-inline"/> installments)</span></div>
                        </button>
                    </div>
                    <group>
                        <group string="Customer">
                            <field name="is_re_customer"/>
                            <field name="re_customer_code" invisible="not re_customer_code"/>
                            <field name="re_national_id"/>
                            <field name="re_birthdate" invisible="is_company"/>
                            <field name="re_source"/>
                            <field name="re_currency_id" invisible="1"/>
                        </group>
                    </group>
                    <field name="re_contract_ids" readonly="1" invisible="not re_contract_ids">
                        <list>
                            <field name="name"/>
                            <field name="project_id"/>
                            <field name="unit_id"/>
                            <field name="date"/>
                            <field name="currency_id" column_invisible="1"/>
                            <field name="total_value" widget="monetary" sum="Total"/>
                            <field name="collected_amount" widget="monetary" sum="Total"/>
                            <field name="remaining_amount" widget="monetary" sum="Total"/>
                            <field name="collection_status" widget="badge" decoration-success="collection_status in ('on_track', 'closed')"
                                   decoration-warning="collection_status == 'at_risk'" decoration-danger="collection_status == 'overdue'"/>
                        </list>
                    </field>
                </page>
            </xpath>
        </field>
    </record>

    <record id="view_partner_list_re_customers" model="ir.ui.view">
        <field name="name">res.partner.list.re.customers</field>
        <field name="model">res.partner</field>
        <field name="priority">50</field>
        <field name="arch" type="xml">
            <list>
                <field name="re_customer_code" string="Code"/>
                <field name="name" string="Customer Name"/>
                <field name="phone" optional="show"/>
                <field name="email" optional="show"/>
                <field name="re_national_id" optional="show"/>
                <field name="company_type" string="Type" widget="badge"/>
                <field name="re_source" optional="hide"/>
                <field name="re_contract_count" string="Contracts"/>
                <field name="re_currency_id" column_invisible="1"/>
                <field name="re_total_value" widget="monetary" options="{'currency_field': 're_currency_id'}"/>
                <field name="re_remaining" widget="monetary" options="{'currency_field': 're_currency_id'}" optional="show"/>
                <field name="re_overdue_amount" widget="monetary" options="{'currency_field': 're_currency_id'}"
                       decoration-danger="re_overdue_amount &gt; 0" optional="show"/>
            </list>
        </field>
    </record>

    <record id="view_partner_search_re_customers" model="ir.ui.view">
        <field name="name">res.partner.search.re.customers</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_res_partner_filter"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='name']" position="after">
                <field name="re_national_id"/>
                <field name="re_customer_code"/>
            </xpath>
            <xpath expr="//search" position="inside">
                <filter name="re_individuals" string="Individuals" domain="[('is_company', '=', False)]"/>
                <filter name="re_corporates" string="Corporates" domain="[('is_company', '=', True)]"/>
                <filter name="re_group_source" string="Customer Source" context="{'group_by': 're_source'}"/>
            </xpath>
        </field>
    </record>

    <record id="action_re_customers" model="ir.actions.act_window">
        <field name="name">Customers</field>
        <field name="res_model">res.partner</field>
        <field name="view_mode">list,kanban,form</field>
        <field name="domain">[('is_re_customer', '=', True)]</field>
        <field name="context">{'default_is_re_customer': True, 'default_customer_rank': 1}</field>
        <field name="view_ids" eval="[(5, 0, 0),
            (0, 0, {'view_mode': 'list', 'view_id': ref('view_partner_list_re_customers')}),
            (0, 0, {'view_mode': 'kanban'}),
            (0, 0, {'view_mode': 'form'})]"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Add your first customer</p>
            <p>Customers are also added automatically when you create a contract.</p>
        </field>
    </record>
</odoo>
