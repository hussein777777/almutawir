<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="re_listing_view_form" model="ir.ui.view">
        <field name="name">re.listing.form</field>
        <field name="model">re.listing</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_submit" type="object" string="Submit for Review"
                            invisible="state not in ('draft', 'rejected')"/>
                    <button name="action_approve" type="object" string="Approve &amp; Publish" class="btn-primary"
                            invisible="state not in ('draft', 'pending', 'rejected')"/>
                    <button name="action_reject_wizard" type="object" string="Reject" invisible="state != 'pending'"/>
                    <button name="action_republish" type="object" string="Bump to Top" invisible="state != 'published'"/>
                    <button name="action_close" type="object" string="Mark Sold / Rented" invisible="state != 'published'"/>
                    <button name="action_reset_draft" type="object" string="Back to Draft"
                            invisible="state in ('draft', 'pending')"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,pending,published,closed"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button class="oe_stat_button" type="object" name="action_view_leads" icon="fa-envelope">
                            <field name="lead_count" widget="statinfo" string="Inquiries"/>
                        </button>
                        <button class="oe_stat_button" disabled="1" icon="fa-eye">
                            <field name="view_count" widget="statinfo" string="Views"/>
                        </button>
                        <field name="is_published" widget="website_redirect_button" invisible="state != 'published'"/>
                    </div>
                    <widget name="web_ribbon" title="Premium" bg_color="text-bg-warning" invisible="not is_premium"/>
                    <div class="alert alert-danger" role="alert" invisible="state != 'rejected' or not rejection_reason">
                        <strong>Rejected: </strong><field name="rejection_reason" readonly="1" class="d-inline"/>
                    </div>
                    <div class="oe_title">
                        <field name="reference" class="text-muted"/>
                        <h1><field name="name" placeholder="e.g. Fully finished 3BR apartment with garden"/></h1>
                    </div>
                    <group>
                        <group string="Property">
                            <field name="listing_type" widget="radio" options="{'horizontal': true}"/>
                            <field name="property_type"/>
                            <field name="completion" widget="radio" options="{'horizontal': true}"/>
                            <field name="sale_type" invisible="listing_type != 'sale'"/>
                            <field name="bedrooms"/>
                            <field name="bathrooms"/>
                            <field name="area"/>
                            <field name="garden_area"/>
                            <field name="floor"/>
                            <field name="finishing"/>
                            <field name="furnishing"/>
                            <field name="delivery_date" invisible="completion != 'offplan'"/>
                        </group>
                        <group string="Price">
                            <field name="currency_id" invisible="1"/>
                            <field name="company_id" invisible="1"/>
                            <field name="price" widget="monetary"/>
                            <field name="rent_period" invisible="listing_type != 'rent'"/>
                            <field name="down_payment" widget="monetary" invisible="listing_type != 'sale'"/>
                            <field name="installment_years" invisible="listing_type != 'sale'"/>
                            <field name="monthly_installment" widget="monetary" invisible="listing_type != 'sale' or not installment_years"/>
                            <field name="price_per_meter" widget="monetary"/>
                            <separator string="Publication"/>
                            <field name="agent_id"/>
                            <field name="agency_id"/>
                            <field name="is_premium"/>
                            <field name="published_date"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Photos" name="photos">
                            <field name="image_ids" mode="kanban" context="{'default_listing_id': id}">
                                <kanban>
                                    <field name="sequence"/>
                                    <templates>
                                        <t t-name="card" class="p-0">
                                            <field name="image_1920" widget="image" options="{'preview_image': 'image_256', 'size': [180, 120]}"/>
                                            <field name="name" class="small px-2"/>
                                        </t>
                                    </templates>
                                </kanban>
                                <form>
                                    <group>
                                        <field name="image_1920" widget="image"/>
                                        <field name="name"/>
                                        <field name="sequence"/>
                                    </group>
                                </form>
                            </field>
                        </page>
                        <page string="Location" name="location">
                            <group>
                                <group>
                                    <field name="location_id"/>
                                    <field name="project_id"/>
                                    <field name="address"/>
                                </group>
                                <group>
                                    <field name="latitude"/>
                                    <field name="longitude"/>
                                    <div colspan="2" class="text-muted small">
                                        Tip: in Google Maps, right-click the building and click the coordinates to copy them.
                                    </div>
                                </group>
                            </group>
                        </page>
                        <page string="Description &amp; Amenities" name="description">
                            <field name="amenity_ids" widget="many2many_tags" options="{'no_create_edit': True}"/>
                            <field name="description" placeholder="Describe the property..."/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="re_listing_view_list" model="ir.ui.view">
        <field name="name">re.listing.list</field>
        <field name="model">re.listing</field>
        <field name="arch" type="xml">
            <list decoration-warning="state == 'pending'" decoration-muted="state in ('closed', 'rejected')">
                <field name="reference"/>
                <field name="name"/>
                <field name="listing_type"/>
                <field name="property_type"/>
                <field name="location_id"/>
                <field name="bedrooms" optional="show"/>
                <field name="area" optional="show"/>
                <field name="currency_id" column_invisible="True"/>
                <field name="price" widget="monetary"/>
                <field name="agent_id"/>
                <field name="agency_id" optional="hide"/>
                <field name="lead_count" optional="show"/>
                <field name="view_count" optional="hide"/>
                <field name="is_premium" widget="boolean_toggle" optional="show"/>
                <field name="state" widget="badge"
                       decoration-info="state == 'draft'"
                       decoration-warning="state == 'pending'"
                       decoration-success="state == 'published'"
                       decoration-danger="state == 'rejected'"/>
            </list>
        </field>
    </record>

    <record id="re_listing_view_kanban" model="ir.ui.view">
        <field name="name">re.listing.kanban</field>
        <field name="model">re.listing</field>
        <field name="arch" type="xml">
            <kanban default_group_by="state" quick_create="false">
                <field name="currency_id"/>
                <field name="cover_image_id"/>
                <templates>
                    <t t-name="card" class="flex-row">
                        <aside class="me-2" t-if="record.cover_image_id.raw_value">
                            <img t-att-src="'/web/image/re.listing.image/' + record.cover_image_id.raw_value + '/image_128'"
                                 class="rounded" style="width: 72px; height: 72px; object-fit: cover;" alt="Photo"/>
                        </aside>
                        <main>
                            <field name="name" class="fw-bold"/>
                            <field name="location_id" class="text-muted small"/>
                            <div class="small">
                                <field name="listing_type"/> · <field name="property_type"/> ·
                                <field name="bedrooms"/> BR · <field name="area"/> m²
                            </div>
                            <field name="price" widget="monetary" class="fw-bold"/>
                            <field name="agent_id" class="small text-muted"/>
                        </main>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="re_listing_view_search" model="ir.ui.view">
        <field name="name">re.listing.search</field>
        <field name="model">re.listing</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="reference"/>
                <field name="location_id" operator="child_of"/>
                <field name="agent_id"/>
                <field name="agency_id"/>
                <filter name="to_review" string="To Review" domain="[('state', '=', 'pending')]"/>
                <filter name="published" string="Published" domain="[('state', '=', 'published')]"/>
                <separator/>
                <filter name="sale" string="For Sale" domain="[('listing_type', '=', 'sale')]"/>
                <filter name="rent" string="For Rent" domain="[('listing_type', '=', 'rent')]"/>
                <separator/>
                <filter name="premium" string="Premium" domain="[('is_premium', '=', True)]"/>
                <group expand="0" string="Group By">
                    <filter name="group_state" string="Status" context="{'group_by': 'state'}"/>
                    <filter name="group_type" string="Property Type" context="{'group_by': 'property_type'}"/>
                    <filter name="group_agency" string="Agency" context="{'group_by': 'agency_id'}"/>
                    <filter name="group_location" string="Location" context="{'group_by': 'location_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="re_listing_action" model="ir.actions.act_window">
        <field name="name">Listings</field>
        <field name="res_model">re.listing</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Create the first listing</p>
            <p>Listings submitted by agents from the portal appear here as "Pending Review".</p>
        </field>
    </record>

    <record id="re_listing_review_action" model="ir.actions.act_window">
        <field name="name">Listings to Review</field>
        <field name="res_model">re.listing</field>
        <field name="view_mode">list,kanban,form</field>
        <field name="context">{'search_default_to_review': 1}</field>
    </record>
</odoo>
