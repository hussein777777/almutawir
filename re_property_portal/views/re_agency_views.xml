<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="re_agency_view_form" model="ir.ui.view">
        <field name="name">re.agency.form</field>
        <field name="model">re.agency</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button class="oe_stat_button" type="object" name="action_view_listings" icon="fa-home">
                            <field name="listing_count" widget="statinfo" string="Listings"/>
                        </button>
                        <field name="is_published" widget="website_redirect_button"/>
                    </div>
                    <widget name="web_ribbon" title="Verified" bg_color="text-bg-success" invisible="not is_verified"/>
                    <field name="image_1920" widget="image" class="oe_avatar" options="{'preview_image': 'image_128'}"/>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="Agency / Developer name"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="agency_type"/>
                            <field name="is_verified"/>
                            <field name="location_id"/>
                        </group>
                        <group>
                            <field name="phone" widget="phone"/>
                            <field name="email" widget="email"/>
                            <field name="website" widget="url"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="About" name="about">
                            <field name="description"/>
                        </page>
                        <page string="Agents" name="agents">
                            <field name="agent_ids" readonly="1">
                                <list>
                                    <field name="name"/>
                                    <field name="phone"/>
                                    <field name="email"/>
                                    <field name="state" widget="badge"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="re_agency_view_list" model="ir.ui.view">
        <field name="name">re.agency.list</field>
        <field name="model">re.agency</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="agency_type"/>
                <field name="agent_count"/>
                <field name="listing_count"/>
                <field name="is_verified" widget="boolean_toggle"/>
                <field name="is_published" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <record id="re_agency_action" model="ir.actions.act_window">
        <field name="name">Agencies &amp; Developers</field>
        <field name="res_model">re.agency</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
