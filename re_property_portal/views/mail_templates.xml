<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Saved search alert email -->
    <template id="mail_search_alert" name="Property Portal: Search Alert Email">
        <div style="font-family: Arial, Helvetica, sans-serif; max-width: 640px; margin: 0 auto; color: #13233F;">
            <div style="background: #06101E; padding: 20px 24px; border-bottom: 3px solid #C8A45D;">
                <span style="color: #C8A45D; font-size: 20px; font-weight: bold;">New properties for you</span>
            </div>
            <div style="padding: 20px 24px; background: #ffffff;">
                <p style="margin: 0 0 16px;">
                    <t t-out="len(listings)"/> new properties match your search
                    "<strong t-out="alert.name"/>".
                </p>
                <t t-foreach="listings" t-as="listing">
                    <table cellpadding="0" cellspacing="0" style="width: 100%; border: 1px solid #eee; border-radius: 8px; margin-bottom: 12px;">
                        <tr>
                            <td style="width: 160px; padding: 0;">
                                <a t-att-href="base_url + listing.website_url">
                                    <img t-if="listing.cover_image_id" t-att-src="'%s/web/image/re.listing.image/%s/image_256' % (base_url, listing.cover_image_id.id)"
                                         style="width: 160px; height: 110px; object-fit: cover; border-radius: 8px 0 0 8px; display: block;" alt=""/>
                                </a>
                            </td>
                            <td style="padding: 12px 16px; vertical-align: top;">
                                <div style="color: #7A5818; font-weight: bold; font-size: 16px;">
                                    <t t-out="'{:,.0f}'.format(listing.price)"/> <t t-out="listing.currency_id.symbol"/>
                                </div>
                                <a t-att-href="base_url + listing.website_url" style="color: #13233F; font-weight: bold; text-decoration: none;" t-out="listing.name"/>
                                <div style="color: #6c757d; font-size: 13px; margin-top: 4px;">
                                    <t t-out="listing._get_location_trail()"/> ·
                                    <t t-out="listing.bedrooms"/> BR · <t t-out="'{:,.0f}'.format(listing.area)"/> m²
                                </div>
                            </td>
                        </tr>
                    </table>
                </t>
                <p style="text-align: center; margin: 24px 0;">
                    <a t-att-href="alert._get_search_url()"
                       style="background: #C8A45D; color: #06101E; padding: 10px 22px; border-radius: 6px; text-decoration: none; font-weight: bold;">
                        See all results
                    </a>
                </p>
                <p style="font-size: 12px; color: #999; text-align: center; margin: 0;">
                    You receive this email because you created a search alert.
                    <a t-att-href="alert._get_unsubscribe_url()" style="color: #999;">Unsubscribe</a>
                </p>
            </div>
        </div>
    </template>

    <!-- New inquiry email to the listing agent -->
    <template id="mail_new_inquiry" name="Property Portal: New Inquiry Email">
        <div style="font-family: Arial, Helvetica, sans-serif; max-width: 600px; margin: 0 auto; color: #13233F;">
            <div style="background: #06101E; padding: 18px 24px; border-bottom: 3px solid #C8A45D;">
                <span style="color: #C8A45D; font-size: 18px; font-weight: bold;">New inquiry on your listing</span>
            </div>
            <div style="padding: 20px 24px; background: #ffffff;">
                <p>Hello <t t-out="agent.name"/>,</p>
                <p>Someone is interested in
                    <a t-att-href="base_url + listing.website_url" style="color: #7A5818; font-weight: bold;" t-out="listing.name"/>
                    (<t t-out="listing.reference"/>).</p>
                <table cellpadding="6" style="border-collapse: collapse; width: 100%; font-size: 14px;">
                    <tr><td style="color: #6c757d; width: 120px;">Name</td><td t-out="lead.contact_name"/></tr>
                    <tr t-if="lead.phone"><td style="color: #6c757d;">Phone</td><td><a t-attf-href="tel:#{lead.phone}" t-out="lead.phone"/></td></tr>
                    <tr t-if="lead.email_from"><td style="color: #6c757d;">Email</td><td><a t-attf-href="mailto:#{lead.email_from}" t-out="lead.email_from"/></td></tr>
                    <tr t-if="lead.description"><td style="color: #6c757d; vertical-align: top;">Message</td><td t-out="lead.description"/></tr>
                </table>
                <p style="margin-top: 20px;">Please contact them as soon as possible. All your inquiries are in
                    <a t-att-href="base_url + '/my/property-leads'" style="color: #7A5818;">My Account</a>.</p>
            </div>
        </div>
    </template>
</odoo>
