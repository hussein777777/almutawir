<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Visitors see published content only; portal agents also see their own -->
    <record id="rule_re_listing_public" model="ir.rule">
        <field name="name">Listing: published (public)</field>
        <field name="model_id" ref="model_re_listing"/>
        <field name="domain_force">[('state', '=', 'published')]</field>
        <field name="groups" eval="[(4, ref('base.group_public'))]"/>
    </record>
    <record id="rule_re_listing_portal" model="ir.rule">
        <field name="name">Listing: published or own (portal)</field>
        <field name="model_id" ref="model_re_listing"/>
        <field name="domain_force">['|', ('state', '=', 'published'), ('agent_id.user_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('base.group_portal'))]"/>
    </record>

    <record id="rule_re_listing_image_public" model="ir.rule">
        <field name="name">Listing photo: published (public)</field>
        <field name="model_id" ref="model_re_listing_image"/>
        <field name="domain_force">[('listing_id.state', '=', 'published')]</field>
        <field name="groups" eval="[(4, ref('base.group_public'))]"/>
    </record>
    <record id="rule_re_listing_image_portal" model="ir.rule">
        <field name="name">Listing photo: published or own (portal)</field>
        <field name="model_id" ref="model_re_listing_image"/>
        <field name="domain_force">['|', ('listing_id.state', '=', 'published'), ('listing_id.agent_id.user_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('base.group_portal'))]"/>
    </record>

    <record id="rule_re_agent_public" model="ir.rule">
        <field name="name">Agent: active and published (public)</field>
        <field name="model_id" ref="model_re_agent"/>
        <field name="domain_force">[('state', '=', 'active'), ('is_published', '=', True)]</field>
        <field name="groups" eval="[(4, ref('base.group_public'))]"/>
    </record>
    <record id="rule_re_agent_portal" model="ir.rule">
        <field name="name">Agent: active and published or self (portal)</field>
        <field name="model_id" ref="model_re_agent"/>
        <field name="domain_force">['|', '&amp;', ('state', '=', 'active'), ('is_published', '=', True), ('user_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('base.group_portal'))]"/>
    </record>

    <record id="rule_re_agency_public" model="ir.rule">
        <field name="name">Agency: published (public / portal)</field>
        <field name="model_id" ref="model_re_agency"/>
        <field name="domain_force">[('is_published', '=', True)]</field>
        <field name="groups" eval="[(4, ref('base.group_public')), (4, ref('base.group_portal'))]"/>
    </record>
</odoo>
