<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="re_listing_reject_wizard_form" model="ir.ui.view">
        <field name="name">re.listing.reject.wizard.form</field>
        <field name="model">re.listing.reject.wizard</field>
        <field name="arch" type="xml">
            <form>
                <field name="listing_ids" invisible="1"/>
                <group>
                    <field name="reason" placeholder="e.g. Photos are blurry, please upload clearer photos of the living room."/>
                </group>
                <footer>
                    <button name="action_reject" type="object" string="Reject" class="btn-danger"/>
                    <button special="cancel" string="Cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
