<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="re_team_member_view_form" model="ir.ui.view">
        <field name="name">re.team.member.form</field>
        <field name="model">re.team.member</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <field name="image_1920" widget="image" class="oe_avatar" options="{'preview_image': 'image_128'}"/>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="Full name"/></h1>
                        <field name="job_title" placeholder="e.g. Chairman &amp; CEO"/>
                    </div>
                    <group>
                        <field name="linkedin_url" widget="url"/>
                        <field name="is_published"/>
                        <field name="active" invisible="1"/>
                    </group>
                    <field name="bio" placeholder="Short biography..."/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="re_team_member_view_list" model="ir.ui.view">
        <field name="name">re.team.member.list</field>
        <field name="model">re.team.member</field>
        <field name="arch" type="xml">
            <list>
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="job_title"/>
                <field name="is_published" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <record id="re_team_member_action" model="ir.actions.act_window">
        <field name="name">Leadership Team</field>
        <field name="res_model">re.team.member</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
