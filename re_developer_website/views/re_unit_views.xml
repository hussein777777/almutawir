<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="re_unit_view_form" model="ir.ui.view">
        <field name="name">re.unit.form</field>
        <field name="model">re.unit</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_reserve" type="object" string="Reserve" class="btn-primary"
                            invisible="state != 'available'"/>
                    <button name="action_sell" type="object" string="Mark as Sold"
                            invisible="state == 'sold'"/>
                    <button name="action_set_available" type="object" string="Set Available"
                            invisible="state == 'available'"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <field name="is_published" widget="website_redirect_button"/>
                    </div>
                    <widget name="web_ribbon" title="Sold" bg_color="text-bg-danger" invisible="state != 'sold'"/>
                    <widget name="web_ribbon" title="Reserved" bg_color="text-bg-warning" invisible="state != 'reserved'"/>
                    <field name="image_1920" widget="image" class="oe_avatar" options="{'preview_image': 'image_128'}"/>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="e.g. B2-104"/></h1>
                        <field name="project_id" placeholder="Project"/>
                    </div>
                    <group>
                        <group string="Specifications">
                            <field name="unit_type"/>
                            <field name="bedrooms"/>
                            <field name="bathrooms"/>
                            <field name="area"/>
                            <field name="garden_area"/>
                            <field name="floor"/>
                            <field name="unit_view"/>
                            <field name="finishing"/>
                            <field name="delivery_date"/>
                            <field name="is_featured"/>
                            <field name="active" invisible="1"/>
                        </group>
                        <group string="Price &amp; Payment Plan">
                            <field name="currency_id" invisible="1"/>
                            <field name="price" widget="monetary"/>
                            <field name="price_per_meter" widget="monetary"/>
                            <field name="down_payment_pct"/>
                            <field name="down_payment_amount" widget="monetary"/>
                            <field name="installment_years"/>
                            <field name="monthly_installment" widget="monetary"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Description" name="description">
                            <field name="description" placeholder="Unit description for the website..."/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="re_unit_view_list" model="ir.ui.view">
        <field name="name">re.unit.list</field>
        <field name="model">re.unit</field>
        <field name="arch" type="xml">
            <list decoration-muted="state == 'sold'">
                <field name="project_id"/>
                <field name="name"/>
                <field name="unit_type"/>
                <field name="bedrooms"/>
                <field name="area" sum="Total Area"/>
                <field name="floor" optional="hide"/>
                <field name="finishing" optional="show"/>
                <field name="currency_id" column_invisible="True"/>
                <field name="price" widget="monetary" sum="Total"/>
                <field name="monthly_installment" widget="monetary" optional="hide"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'available'"
                       decoration-warning="state == 'reserved'"
                       decoration-danger="state == 'sold'"/>
                <field name="is_featured" widget="boolean_toggle" optional="show"/>
                <field name="is_published" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <record id="re_unit_view_kanban" model="ir.ui.view">
        <field name="name">re.unit.kanban</field>
        <field name="model">re.unit</field>
        <field name="arch" type="xml">
            <kanban default_group_by="state">
                <field name="currency_id"/>
                <templates>
                    <t t-name="card" class="flex-row">
                        <aside class="me-2">
                            <field name="image_128" widget="image" alt="Unit"/>
                        </aside>
                        <main>
                            <field name="name" class="fw-bold"/>
                            <field name="project_id" class="text-muted"/>
                            <div class="small">
                                <field name="unit_type"/> ·
                                <field name="bedrooms"/> BR ·
                                <field name="area"/> m²
                            </div>
                            <field name="price" widget="monetary" class="fw-bold"/>
                        </main>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="re_unit_view_search" model="ir.ui.view">
        <field name="name">re.unit.search</field>
        <field name="model">re.unit</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="project_id"/>
                <filter name="available" string="Available" domain="[('state', '=', 'available')]"/>
                <filter name="reserved" string="Reserved" domain="[('state', '=', 'reserved')]"/>
                <filter name="sold" string="Sold" domain="[('state', '=', 'sold')]"/>
                <separator/>
                <filter name="published" string="Published" domain="[('is_published', '=', True)]"/>
                <filter name="featured" string="Featured" domain="[('is_featured', '=', True)]"/>
                <group expand="0" string="Group By">
                    <filter name="group_project" string="Project" context="{'group_by': 'project_id'}"/>
                    <filter name="group_type" string="Type" context="{'group_by': 'unit_type'}"/>
                    <filter name="group_state" string="Status" context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="re_unit_action" model="ir.actions.act_window">
        <field name="name">Units</field>
        <field name="res_model">re.unit</field>
        <field name="view_mode">list,kanban,form</field>
        <field name="context">{'search_default_group_project': 1}</field>
    </record>
</odoo>
