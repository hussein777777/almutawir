<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="website_view_re_profile_list" model="ir.ui.view">
        <field name="name">website.re.profile.list</field>
        <field name="model">website</field>
        <field name="priority">100</field>
        <field name="arch" type="xml">
            <list create="0" delete="0">
                <field name="name"/>
                <field name="domain"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <record id="website_view_re_profile_form" model="ir.ui.view">
        <field name="name">website.re.profile.form</field>
        <field name="model">website</field>
        <field name="priority">100</field>
        <field name="arch" type="xml">
            <form create="0" delete="0" string="Company Profile">
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <notebook>
                        <page string="Homepage Hero" name="hero">
                            <group>
                                <group>
                                    <field name="logo" widget="image" options="{'size': [180, 60]}"
                                           string="Website Logo"/>
                                    <field name="re_tagline"/>
                                    <field name="re_hero_subtitle"/>
                                </group>
                                <group>
                                    <field name="re_hero_image" widget="image" options="{'size': [320, 180]}"/>
                                </group>
                            </group>
                        </page>
                        <page string="Overview &amp; Interview" name="overview">
                            <group>
                                <field name="re_overview_title"/>
                                <field name="re_video_url" widget="url"
                                       placeholder="https://www.youtube.com/watch?v=..."/>
                                <field name="re_vision"/>
                                <field name="re_mission"/>
                            </group>
                            <field name="re_overview" placeholder="Who we are, our story and values..."/>
                        </page>
                        <page string="Key Figures" name="figures">
                            <group>
                                <group>
                                    <field name="re_founded_year" options="{'format': false}"/>
                                    <field name="re_years_experience"/>
                                </group>
                                <group>
                                    <field name="re_projects_count"/>
                                    <field name="re_units_count"/>
                                    <field name="re_clients_count"/>
                                </group>
                            </group>
                        </page>
                        <page string="Contact &amp; Leads" name="contact">
                            <group>
                                <group string="Contact">
                                    <field name="company_id" readonly="1"/>
                                    <field name="re_whatsapp" placeholder="+20 100 000 0000"/>
                                    <field name="re_office_hours"/>
                                </group>
                                <group string="Website Inquiries Go To">
                                    <field name="re_lead_team_id"/>
                                    <field name="re_lead_user_id"/>
                                </group>
                            </group>
                            <div class="text-muted">Phone, email and address are taken from the company record.</div>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="website_re_profile_action" model="ir.actions.act_window">
        <field name="name">Company Profile</field>
        <field name="res_model">website</field>
        <field name="view_mode">list,form</field>
        <field name="view_ids" eval="[(5, 0, 0),
            (0, 0, {'view_mode': 'list', 'view_id': ref('website_view_re_profile_list')}),
            (0, 0, {'view_mode': 'form', 'view_id': ref('website_view_re_profile_form')})]"/>
    </record>
</odoo>
