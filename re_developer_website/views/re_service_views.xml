<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="re_service_view_form" model="ir.ui.view">
        <field name="name">re.service.form</field>
        <field name="model">re.service</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <field name="is_published" widget="website_redirect_button"/>
                    </div>
                    <field name="image_1920" widget="image" class="oe_avatar" options="{'preview_image': 'image_128'}"/>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="e.g. General Contracting"/></h1>
                    </div>
                    <group>
                        <field name="icon"/>
                        <field name="short_description"/>
                        <field name="active" invisible="1"/>
                    </group>
                    <field name="description" placeholder="Detailed description..."/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="re_service_view_list" model="ir.ui.view">
        <field name="name">re.service.list</field>
        <field name="model">re.service</field>
        <field name="arch" type="xml">
            <list>
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="icon"/>
                <field name="short_description"/>
                <field name="is_published" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <record id="re_service_action" model="ir.actions.act_window">
        <field name="name">Services</field>
        <field name="res_model">re.service</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
